{
  "schema_version": 2,
  "project_id": "example-advanced",
  "repo": "/absolute/path/to/repo",
  "base_ref": "HEAD",
  "backend": "local-process",
  "network": "none",
  "network_policy_confirmed": false,
  "default_agent_profile": "cb-edits",
  "agent_profiles": {
    "cb-edits": {
      "adapter": "codebuddy",
      "backend": "codebuddy-cli",
      "expected_version": "REPLACE_WITH_EXACT_CLI_VERSION",
      "permission_profile": "isolated-edit-and-run",
      "require_permission_binding": true,
      "credential_refs": ["model-codebuddy"],
      "env_names": ["PATH", "HOME"],
      "network_profile": "none",
      "model": "REPLACE_WITH_VERIFIED_MODEL_ID",
      "provider": "REPLACE_WITH_PROVIDER_ID",
      "model_variant": "REPLACE_WITH_VARIANT_OR_DELETE_THIS_FIELD",
      "reasoning_effort": "medium",
      "endpoint_ref": "private-gateway",
      "cost_class": "standard",
      "latency_class": "standard",
      "max_turns": 40,
      "max_output_bytes": 200000,
      "approved_tools": ["read", "edit", "shell"],
      "capabilities": {
        "input_modalities": ["text"],
        "context_window": 128000,
        "tool_use": true,
        "structured_result": true,
        "max_output_tokens": 8192
      },
      "unit_price": {
        "input_per_1k": 0.003,
        "output_per_1k": 0.015,
        "currency": "USD"
      },
      "compatibility_evidence": "compat/cb-edits.json",
      "description": "用途：全字段示例。依据：尚未验证；compatibility_evidence 指向的文件必须真实存在。"
    }
  },
  "endpoints": {
    "private-gateway": {
      "class": "private",
      "attestation": "config-declared"
    }
  },
  "routing": {
    "schema_version": 1,
    "mode": "explicit",
    "allowed_profiles": ["cb-edits"],
    "fallback": "ask",
    "max_assignments": 1,
    "cost_ceiling": "standard",
    "spend_guard": {
      "max_cost_per_task": 5.0,
      "max_cost_per_day": null,
      "currency": "USD",
      "on_exceed": "block"
    }
  },
  "authorization_ref": "REPLACE_WITH_REAL_SCOPE",
  "authorized_actions": ["create", "execute"],
  "allowed_paths": ["src", "tests"],
  "protected_paths": [".env", ".github"],
  "shared_resources": [
    {"kind": "test-database", "id": "dev-postgres"},
    {"kind": "port", "id": "5432"}
  ],
  "checks": [
    {
      "id": "unit",
      "argv": ["pnpm", "exec", "vitest", "run"]
    }
  ],
  "verification": {
    "network": "none"
  },
  "max_active_tasks": 1,
  "max_attempts": 3,
  "timeout_seconds": 3600,
  "github_repo": "owner/repository",
  "remote": "origin",
  "target_branch": "main",
  "ci_required": true,
  "required_ci_checks": ["unit"]
}
